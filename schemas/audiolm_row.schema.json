{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hwangbo/train paired AudioLM record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messages",
    "audios"
  ],
  "properties": {
    "messages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "content"
          ],
          "properties": {
            "role": {
              "const": "user"
            },
            "content": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "content"
          ],
          "properties": {
            "role": {
              "const": "assistant"
            },
            "content": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "audios": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
